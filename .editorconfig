root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official
# The root package io.github.big_sw_little_sw.folio contains underscores; detekt's PackageNaming checks packages.
ktlint_standard_package-name = disabled
