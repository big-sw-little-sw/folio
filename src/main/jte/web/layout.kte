<%-- The page layout of the UI. Each page gives its title and content. --%>
@import gg.jte.Content
@import io.github.big_sw_little_sw.folio.web.PageContext
@param page: PageContext
@param title: String
@param content: Content
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${title} · Folio</title>
    @if(page.csrf != null)
        <meta name="csrf-header" content="${page.csrf.headerName}">
        <meta name="csrf-token" content="${page.csrf.token}">
    @endif
    <%-- The content security policy blocks inline styles and eval. These settings stop htmx from using them. --%>
    <meta name="htmx-config" content='{"includeIndicatorStyles": false, "allowEval": false}'>
    <link rel="stylesheet" href="/css/folio.css">
    <%--
        htmx 2.0.11 from https://registry.npmjs.org/htmx.org/-/htmx.org-2.0.11.tgz (dist/htmx.min.js).
        SHA-256: d6fdc75f204e6bdefa99b69bf1e6d4ac69b8a364f77929f45c13476b4000f717.
        The integrity attribute makes the browser refuse a different file. Change the file and the attribute together.
    --%>
    <script src="/js/htmx-2.0.11.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" defer></script>
    <script src="/js/folio.js" defer></script>
</head>
<body>
@template.web.internal.header(page = page)
<main>
    @template.web.notice(notice = page.notice)
    ${content}
</main>
</body>
</html>
