<%-- The CSRF token of a form that changes data (design 12.3). Only a signed-in caller has a token. --%>
@import io.github.big_sw_little_sw.folio.web.PageContext
@param page: PageContext
@if(page.csrf != null)
    <input type="hidden" name="${page.csrf.parameterName}" value="${page.csrf.token}">
@endif
