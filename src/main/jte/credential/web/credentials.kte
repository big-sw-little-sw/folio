<%--
    The credentials of a Namespace and the create form (design 11.1, 12.3). The catalog does not depend on the
    credential module. Thus the Namespace page of the catalog links to this page by its URL only.
--%>
@import io.github.big_sw_little_sw.folio.catalog.Namespace
@import io.github.big_sw_little_sw.folio.credential.internal.Credential
@import io.github.big_sw_little_sw.folio.web.FolioException
@import io.github.big_sw_little_sw.folio.web.PageContext
@param page: PageContext
@param namespace: Namespace
@param namespaceReadable: Boolean
@param credentials: List<Credential>
@param name: String?
@param gitInstance: String?
@param problem: FolioException? = null
@template.web.layout(page = page, title = "Credentials of " + namespace.path, content = @`
    <nav class="crumbs" aria-label="Path">
        <a href="/">Catalog</a> /
        @if(namespaceReadable)
            <a href="/namespaces/${namespace.id.toApiId()}">${namespace.path.toString()}</a>
        @else
            ${namespace.path.toString()}
        @endif
        /
        Credentials
    </nav>
    <h1>Credentials <span class="kind">of ${namespace.path.toString()}</span></h1>
    <p>
        A credential is the SSH identity that Folio uses to read repositories on one Git instance. A ConfigSet can use
        a credential of this Namespace only if its creator has MANAGE here.
    </p>
    @if(credentials.isEmpty())
        <p class="muted">This Namespace has no credentials.</p>
    @else
        <table>
            <thead>
                <tr><th>Name</th><th>Git instance</th><th>Status</th></tr>
            </thead>
            <tbody>
                @for(credential in credentials)
                    <tr>
                        <td><a href="/credentials/${credential.id.toApiId()}">${credential.name.value}</a></td>
                        <td><code>${credential.gitInstance.value}</code></td>
                        <td>${credential.status.name}</td>
                    </tr>
                @endfor
            </tbody>
        </table>
    @endif
    <h2>Create a credential</h2>
    @if(problem != null)
        @template.web.problem(code = problem.code, detail = problem.detail)
    @endif
    <form class="stacked" method="post" action="/namespaces/${namespace.id.toApiId()}/credentials">
        @template.web.csrfField(page = page)
        <label for="name">Name</label>
        <input id="name" name="name" value="${name}" required maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" aria-describedby="name-help">
        <small id="name-help">1 to 100 lowercase letters, digits and single hyphens between them. Unique in this Namespace.</small>
        <label for="git-instance">Git instance</label>
        <input id="git-instance" name="gitInstance" value="${gitInstance}" required maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" aria-describedby="git-instance-help">
        <small id="git-instance-help">The name of the Git server in the deployment configuration, for example <code>github-internal</code>.</small>
        <button type="submit">Create</button>
    </form>
`)
