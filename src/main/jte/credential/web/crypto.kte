<%--
    The master-key page for super admins (design 11.3, 12.3). An operator can remove a version from the
    configuration when the version has zero keys.
--%>
@import io.github.big_sw_little_sw.folio.credential.internal.MasterKeyStatus
@import io.github.big_sw_little_sw.folio.web.FolioException
@import io.github.big_sw_little_sw.folio.web.PageContext
@param page: PageContext
@param status: MasterKeyStatus
@param problem: FolioException? = null
@template.web.layout(page = page, title = "Master keys", content = @`
    <h1>Master keys</h1>
    <p>Folio encrypts each private key with a master-key version. The active version encrypts new keys.</p>
    <table>
        <thead>
            <tr><th>Version</th><th>Encrypted keys</th></tr>
        </thead>
        <tbody>
            @for(entry in status.keysByVersion)
                <tr>
                    <td>${entry.key}@if(entry.key == status.activeVersion) <strong>(active)</strong>@endif</td>
                    <td>${entry.value}</td>
                </tr>
            @endfor
        </tbody>
    </table>
    @if(problem != null)
        @template.web.problem(code = problem.code, detail = problem.detail)
    @endif
    <form method="post" action="/crypto/reencrypt">
        @template.web.csrfField(page = page)
        <p>
            The re-encryption encrypts each key again with the active version. Then remove an old version from the
            configuration only when it has zero keys.
        </p>
        <button type="submit">Re-encrypt</button>
    </form>
`)
