<%--
    A credential with its keys and the forms of its operations (design 11.1, 12.3). The page shows each public key as
    an OpenSSH line to copy into the Git service. The page never shows a private key.
--%>
@import io.github.big_sw_little_sw.folio.credential.internal.Credential
@import io.github.big_sw_little_sw.folio.credential.internal.KeyStatus
@import io.github.big_sw_little_sw.folio.web.FolioException
@import io.github.big_sw_little_sw.folio.web.PageContext
@param page: PageContext
@param credential: Credential
@param namespaceReadable: Boolean
@param problem: FolioException? = null
!{val url = "/credentials/" + credential.id.toApiId()}
!{val namespaceUrl = "/namespaces/" + credential.namespaceId.toApiId()}
@template.web.layout(page = page, title = "Credential " + credential.name.value, content = @`
    <nav class="crumbs" aria-label="Path">
        <a href="/">Catalog</a> /
        @if(namespaceReadable)
            <a href="${namespaceUrl}">${credential.namespacePath.toString()}</a>
        @else
            ${credential.namespacePath.toString()}
        @endif
        /
        <a href="${namespaceUrl}/credentials">Credentials</a> /
        <a href="${url}" aria-current="page">${credential.name.value}</a>
    </nav>
    <h1>${credential.name.value} <span class="kind">Credential</span></h1>
    <dl>
        <dt>ID</dt>
        <dd><code>${credential.id.toApiId()}</code></dd>
        <dt>Git instance</dt>
        <dd><code>${credential.gitInstance.value}</code></dd>
        <dt>Status</dt>
        <dd>${credential.status.name}</dd>
    </dl>
    @if(problem != null)
        @template.web.problem(code = problem.code, detail = problem.detail)
    @endif
    <h2>Keys</h2>
    <p>
        Register the public key of the active key with the Git service, as a deploy key or on a bot account. The
        comment of each line is the ID of the key.
    </p>
    @for(key in credential.keys.reversed())
        <section class="key">
            <h3>${key.status.name} <code>${key.id.toApiId()}</code></h3>
            <p>Fingerprint: <code>${key.fingerprint}</code></p>
            <label for="public-key-${key.id.toApiId()}">Public key</label>
            <textarea id="public-key-${key.id.toApiId()}" class="public-key" rows="2" readonly>${key.publicKeyLine}</textarea>
            @if(key.status == KeyStatus.PENDING && credential.enabled)
                <form class="inline" method="post" action="${url}/activate">
                    @template.web.csrfField(page = page)
                    <input type="hidden" name="keyId" value="${key.id.toApiId()}">
                    <button type="submit">Activate this key</button>
                </form>
                <form class="inline" method="post" action="${url}/discard">
                    @template.web.csrfField(page = page)
                    <input type="hidden" name="keyId" value="${key.id.toApiId()}">
                    <button type="submit">Discard this key</button>
                </form>
            @endif
        </section>
    @endfor
    <h2>Operations</h2>
    @if(credential.enabled)
        @if(credential.pendingKey == null)
            <form method="post" action="${url}/regenerate">
                @template.web.csrfField(page = page)
                <p>Rotation has two steps. Add a pending key, register it with the Git service, and then activate it.</p>
                <button type="submit">Add a pending key</button>
            </form>
        @endif
        <form method="post" action="${url}/replace">
            @template.web.csrfField(page = page)
            <p>For emergencies. Folio retires the active key and the pending key, and activates a new key immediately.</p>
            <button class="danger" type="submit">Replace the keys</button>
        </form>
        <form method="post" action="${url}/disable">
            @template.web.csrfField(page = page)
            <p>A disabled credential gives no key to sync and refuses key changes. You cannot enable it again.</p>
            <button class="danger" type="submit">Disable the credential</button>
        </form>
    @endif
    <form method="post" action="${url}/delete">
        @template.web.csrfField(page = page)
        <p>Folio deletes a credential and all its keys only when no Git source uses it.</p>
        <button class="danger" type="submit">Delete the credential</button>
    </form>
`)
