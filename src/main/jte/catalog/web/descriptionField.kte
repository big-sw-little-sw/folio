@param description: String?
<%--
    The HTML parser removes the first line break after <textarea>. The template puts a line break there for the parser
    to remove. Without that line break, a description that starts with a line break loses its first line break.
--%>
<label for="description">Description</label>
<textarea id="description" name="description" maxlength="1000" rows="3" aria-describedby="description-help">
${description}</textarea>
<small id="description-help">Optional. 1,000 characters or fewer.</small>
