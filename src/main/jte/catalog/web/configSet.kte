<%--
    The catalog does not depend on the content module, so this page links to the files page and the revisions page of
    the content module by path only. Only the content module knows the latest revision, so this page does not show it.
--%>
@import io.github.big_sw_little_sw.folio.catalog.ConfigSet
@import io.github.big_sw_little_sw.folio.catalog.web.Operations
@import io.github.big_sw_little_sw.folio.catalog.web.ResourceView
@import io.github.big_sw_little_sw.folio.web.PageContext
@param page: PageContext
@param resource: ResourceView
@param configSet: ConfigSet
@param operations: Operations
@template.web.layout(page = page, title = resource.path, content = @`
    @template.catalog.web.crumbs(resource = resource)
    <h1>${resource.slug} <span class="kind">ConfigSet</span></h1>
    <dl>
        @template.catalog.web.facts(resource = resource)
        <dt>Source</dt>
        <dd>${configSet.sourceType.name}</dd>
    </dl>
    <nav class="operations" aria-label="Content">
        <a href="${resource.url}/files">Files at the latest revision</a>
        <a href="${resource.url}/revisions">Revisions</a>
    </nav>
    @template.catalog.web.operations(resource = resource, operations = operations)
`)
